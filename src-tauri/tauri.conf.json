{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reclaim",
  "version": "0.3.0",
  "identifier": "com.reclaim.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reclaim",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Uninstall apps, find what's filling your drive, and clean up Windows.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/context-menu.wxs"],
        "componentRefs": ["ScanContextMenu"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENEI3N0M3MzNBODg2REEKUldUYWhxZ3p4M2RMalZNODdWNzJxNHB0MWFGTDQ1UFh6WVBvQXZQZVlaNmVrOXNyZWRTTDZ0Zk4K",
      "endpoints": [
        "https://github.com/nalyDzzz/reclaim/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
